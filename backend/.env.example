# App
APP_NAME=Citizen Fraud Shield API
DEBUG=true
API_PREFIX=/api

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
UPLOAD_DIR=uploads
DATABASE_URL=sqlite:///./storage/fraud_shield.db

# Upload limits
MAX_UPLOAD_MB=8

# Cloud OCR — Screenshot scanning (no Tesseract / no system packages needed)
# OCR.Space: free at https://ocr.space/ocrapi (25,000 req/month)
# Leave unset to use the "helloworld" demo key (25 req/hour, testing only)
OCR_SPACE_API_KEY=helloworld

# Optional: Google Cloud Vision for higher-accuracy OCR
# When set, Vision is preferred and OCR.Space acts as fallback
# Enable the Vision API in your GCP project and create an API key
# GOOGLE_CLOUD_VISION_API_KEY=your_key_here
